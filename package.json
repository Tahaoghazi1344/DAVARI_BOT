{
  "name": "persian-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "description": "ربات تلگرام فارسی چندقابلیتی روی Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute BOT_DB --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute BOT_DB --remote --file=./migrations/0001_init.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  }
}
